# 复制成 .env 后按需修改（.env 已被 git 忽略）。线上部署直接给环境变量，不需要 .env；
# 已存在的环境变量优先于 .env。仓库里只放示例，不要写真实网址和密钥。

# ---- 必填 ----
DATABASE_URL=postgres://user:password@127.0.0.1:5432/tianji
AUTH_SECRET=change-me            # 登录 token 的签名密钥；换掉会让所有人重新登录

# ---- 服务 ----
PORT=8080
# CORS 来源白名单，逗号分隔；不设则用默认：
# https://acc2023156.github.io,http://localhost:8765,http://localhost:8766
# CORS_ALLOW_ORIGINS=
# PG_POOL_MAX=10
# MAX_BODY_BYTES=5242880          # 请求体上限，默认 5MB
# UPSTREAM_TIMEOUT_MS=0           # 写作上游超时，0 = 不设

# ---- 密码 ----
ADMIN_KEY=                        # 会员后台密码（X-Admin-Key）
ACCESS_CODE=                      # 内部通行码（X-Tianji-Code，不扣积分）
JOB_SECRET=                       # GitHub Actions 回报、热点推送用的密码（X-Job-Secret）

# ---- 模型上游 ----
YQ_BASE=                          # 云桥（天玑写剧本的主力）
YQ_KEY=
QWEN_BASE=                        # 公司模型
QWEN_KEY=

# ---- 长剧本任务（交给 GitHub Actions 跑）----
GH_TOKEN=
# GH_REPO=acc2023156/drama-prompt-library
# GH_WORKFLOW=script-job.yml
